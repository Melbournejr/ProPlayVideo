<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Mặc định chặn toàn bộ Cleartext HTTP trên toàn ứng dụng -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>